# PostgreSQL (Neon, Supabase Postgres, or another managed PostgreSQL service).
# Never put production credentials in Git.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# REQUIRED for the single-administrator private preview gate; not multi-tenant authentication.
APP_ADMIN_EMAIL="admin@example.com"
APP_ADMIN_PASSWORD="replace-with-a-random-password-at-least-16-characters"
AUTH_SESSION_SECRET="replace-with-a-unique-random-string-of-at-least-32-characters"

# Prepared for future NextAuth integration; not currently used by the private preview gate.
NEXTAUTH_URL="https://leadveyra.com"
NEXTAUTH_SECRET="replace-with-another-random-string"

# Optional integrations; keep outbound sending disabled until verified.
SERPER_API_KEY=""
RESEND_API_KEY=""
EMAIL_SENDING_ENABLED="false"
EMAIL_FROM=""
