// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  people    Person[]
  companies Company[]
  sources   Source[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  role           String   @default("member")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
}

model Person {
  id             String   @id @default(cuid())
  name           String
  title          String?
  email          String?
  linkedin       String?
  phone          String?
  country        String?
  tier           String?
  status         String   @default("New")
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  appearances    Appearance[]
  activities     Activity[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Company {
  id             String   @id @default(cuid())
  name           String
  website        String?
  industry       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  people         Person[]
  createdAt      DateTime @default(now())
}

model Source {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("magazine")
  url            String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  appearances    Appearance[]
  createdAt      DateTime @default(now())
}

model Appearance {
  id        String   @id @default(cuid())
  date      String?
  url       String?
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id])
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  content   String
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())
}