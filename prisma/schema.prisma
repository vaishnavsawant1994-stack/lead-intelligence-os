// Leadveyra private-preview CRM schema. Data is always scoped by organizationId.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  people    Person[]
  companies Company[]
  sources   Source[]
  tasks     Task[]
  deals     Deal[]
  auditEvents AuditEvent[]
  suppressionEntries SuppressionEntry[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  role           String       @default("member")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
}

model Person {
  id             String       @id @default(cuid())
  name           String
  title          String?
  email          String?
  linkedin       String?
  phone          String?
  country        String?
  tier           String?
  status         String       @default("New")
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id])
  appearances    Appearance[]
  activities     Activity[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Nullable email allows contacts without an email. All new email values
  // are normalized to lowercase by the preview API before writing.
  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model Company {
  id             String       @id @default(cuid())
  name           String
  website        String?
  industry       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  people         Person[]
  createdAt      DateTime     @default(now())

  @@index([organizationId, name])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  completed      Boolean      @default(false)
  dueAt          DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, completed])
}

model Deal {
  id             String       @id @default(cuid())
  name           String
  value          Decimal      @default(0) @db.Decimal(12, 2)
  stage          String       @default("New")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, stage])
}

model Source {
  id             String       @id @default(cuid())
  name           String
  type           String       @default("magazine")
  url            String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  appearances    Appearance[]
  createdAt      DateTime     @default(now())
}

model Appearance {
  id        String   @id @default(cuid())
  date      String?
  url       String?
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id])
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  content   String
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorEmail     String
  entityType     String
  entityId       String
  action         String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model SuppressionEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  reason         String
  note           String?
  createdAt      DateTime     @default(now())

  // One suppression per address and organization. No public or preview delete.
  @@unique([organizationId, email])
  @@index([organizationId, createdAt])
}
